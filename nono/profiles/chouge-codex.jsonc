{
  // 共通のlocal accessとnono組み込みのCodex policyを合成する。
  "extends": ["chouge-agent-common", "codex"],
  "meta": {
    "name": "chouge-codex",
    "version": "0.1.0",
    "description": "Local Codex profile"
  },
  "network": {
    // Local development services, including container-published MySQL, use loopback.
    "allow_domain": ["chatgpt.com", "localhost", "127.0.0.1"],

    // On macOS, port 0 is nono's canonical localhost:* outbound grant.
    "open_port": [0]
  }
}

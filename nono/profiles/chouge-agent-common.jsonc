{
  // すべてのlocal coding agentで共有するcapabilityを定義する。
  "extends": "default",
  "meta": {
    "name": "chouge-agent-common",
    "version": "0.1.0",
    "description": "Shared runtime access for local coding agents"
  },
  "unsafe_macos_seatbelt_rules": [
    "(allow network-outbound (path \"@HOME@/ghq/github.com/nananaman/dotfiles/herdr/herdr.sock\"))"
  ],
  "groups": {
    "include": [
      // 一般的な開発で利用するtoolchainとpackage managerを許可する。
      "bun_runtime",
      "go_runtime",
      "go_runtime_linux",
      "go_runtime_macos",
      "java_runtime",
      "mise_manager",
      "nix_runtime",
      "node_runtime",
      "python_runtime",
      "rust_runtime",

      // default profileの変更後も、危険なcommandの実行防止を維持する。
      "dangerous_commands",
      "dangerous_commands_macos",
      "dangerous_commands_linux",

      // credential、個人情報、shellに保存されたsecretへのaccessを拒否する。
      "deny_credentials",
      "deny_keychains_macos",
      "deny_keychains_linux",
      "deny_browser_data_macos",
      "deny_browser_data_linux",
      "deny_macos_private",
      "deny_shell_history",
      "deny_shell_configs"
    ]
  },
  "network": {
    // 一般的な開発、package取得、LLM API、Google Cloud APIへの接続を許可する。
    "network_profile": "enterprise",

    // enterprise profileに含まれないが、日常的な開発で利用するdomainを追加する。
    "allow_domain": [
      "api.github.com",
      "chatgpt.com",
      "proxy.golang.org",
      "sum.golang.org",

      // OpenAIの開発者向け文書とGitHub Releasesの成果物取得で利用する。
      "developers.openai.com",
      "release-assets.githubusercontent.com",

      // Google認証とcontainer registryで利用する。
      "accounts.google.com",
      "gcr.io",
      "*.pkg.dev"
    ]
  },
  "filesystem": {
    "allow": [
      "$HOME/.agents",
      "$HOME/.claude",
      "$HOME/.codex",
      "$HOME/.pi",
      "$HOME/.local/state/mise",
      "$HOME/go/pkg/mod",

      // ghq管理のrepositoryを調査、clone、修正できるようにする。
      "$HOME/ghq"
    ],
    "allow_file": [
      "$HOME/.claude.json",
      "$HOME/.claude.json.lock",
      "$HOME/.claude.lock"
    ],
    "bypass_protection": [
      "$HOME/ghq/github.com/nananaman/dotfiles/zsh/zshrc"
    ],
    "read": ["$HOME/.local/share/nono-agent-wrappers"]
  },
  "platform_overrides": {
    "macos": {
      "filesystem": {
        "read": ["$HOME/.vite-plus"],
        "write_file": [
          "$HOME/.vite-plus/cache/resolve_cache.json",
          "$HOME/.vite-plus/js_runtime/node/index_cache.json"
        ]
      }
    }
  },
  "command_policies": {
    "credentials": {
      // gh auth tokenの出力をbroker内へ保持し、agentにはnonceだけを返す。
      "github": {
        "type": "ambient"
      }
    },
    // credentialやhost daemonを扱うcommandだけを、親sessionより狭い権限で実行する。
    "commands": {
      "gh": {
        "executable": "@GH_BIN@",
        "intercept": [
          {
            "args": ["auth", "token"],
            "action": {
              "type": "capture_credential",
              "credential": "github"
            },
            "sandbox": {
              // token取得時だけhost側のgh login情報を読み、networkは許可しない。
              "fs_read_file": [
                "$HOME/.config/gh/config.yml",
                "$HOME/.config/gh/hosts.yml"
              ],
              "environment": {
                "allow_vars": ["HOME", "LANG", "LC_*", "PATH"]
              }
            }
          }
        ],
        "from": {
          "session": {
            "sandbox": {
              // ghは認証済み設定を読めるが、agent本体はprotected pathを読めない。
              "fs_read": ["$HOME/ghq"],
              "fs_read_file": [
                "$HOME/.config/gh/config.yml",
                "$HOME/.config/gh/hosts.yml"
              ],
              "fs_write": ["$HOME/ghq"],
              // macOSのTool Sandboxはhostname単位のraw network制限を行えない。
              "network": {
                "allow_all": true
              },
              "environment": {
                "allow_vars": ["HOME", "LANG", "LC_*", "PATH", "TERM"],
                "set_vars": {
                  "GH_PAGER": "",
                  "PAGER": ""
                }
              }
            },
            "invocation_policy": {
              // 日常的なGitHub操作は自走させ、credentialやhost設定の変更だけ拒否する。
              "default": "allow",
              "deny": [
                {
                  "argv": { "prefix": ["auth", "login"] },
                  "reason": "GitHub credential changes stay outside agent sessions"
                },
                {
                  "argv": { "prefix": ["auth", "logout"] },
                  "reason": "GitHub credential changes stay outside agent sessions"
                },
                {
                  "argv": { "prefix": ["auth", "refresh"] },
                  "reason": "GitHub credential changes stay outside agent sessions"
                },
                {
                  "argv": { "prefix": ["auth", "setup-git"] },
                  "reason": "GitHub credential changes stay outside agent sessions"
                },
                {
                  "argv": { "prefix": ["auth", "switch"] },
                  "reason": "GitHub credential changes stay outside agent sessions"
                },
                {
                  "argv": { "prefix": ["auth", "git-credential", "store"] },
                  "reason": "GitHub credential changes stay outside agent sessions"
                },
                {
                  "argv": { "prefix": ["auth", "git-credential", "erase"] },
                  "reason": "GitHub credential changes stay outside agent sessions"
                },
                {
                  "argv": { "prefix": ["config", "set"] },
                  "reason": "GitHub CLI configuration changes stay outside agent sessions"
                },
                {
                  "argv": { "prefix": ["secret"] },
                  "reason": "GitHub secret changes stay outside agent sessions"
                },
                {
                  "argv": { "contains": ["--hostname"] },
                  "reason": "GitHub credential use is restricted to the configured host"
                }
              ]
            }
          }
        }
      },
      "container": {
        "executable": "/opt/homebrew/opt/container/libexec/container",
        "from": {
          "session": {
            "sandbox": {
              "fs_read": [
                "/opt/homebrew/opt/container",
                "$WORKDIR",
                "$HOME/Library/Application Support/com.apple.container"
              ],
              "fs_read_file": ["/bin/launchctl"],
              "fs_write": ["$WORKDIR", "$HOME/Library/Application Support/com.apple.container"],
              "environment": {
                "set_vars": {
                  "CONTAINER_INSTALL_ROOT": "/opt/homebrew/opt/container"
                }
              },
              "unsafe_macos_seatbelt_rules": ["(allow process-exec (literal \"/bin/launchctl\"))"]
            },
            "invocation_policy": {
              "default": "deny",
              "deny": [
                {
                  "argv": { "prefix": ["registry", "login"] },
                  "reason": "registry credential changes stay outside agent sessions"
                },
                {
                  "argv": { "prefix": ["registry", "logout"] },
                  "reason": "registry credential changes stay outside agent sessions"
                },
                {
                  "argv": { "prefix": ["system", "dns", "create"] },
                  "reason": "host DNS and packet-filter changes are not delegated to agents"
                },
                {
                  "argv": { "prefix": ["system", "dns", "delete"] },
                  "reason": "host DNS and packet-filter changes are not delegated to agents"
                },
                {
                  "argv": { "prefix": ["system", "kernel", "set"] },
                  "reason": "system kernel changes are not delegated to agents"
                }
              ],
              "allow": [
                { "argv": { "exact": [] } },
                { "argv": { "exact": ["--help"] } },
                { "argv": { "exact": ["--version"] } },
                { "argv": { "prefix": ["list"] } },
                { "argv": { "prefix": ["inspect"] } },
                { "argv": { "prefix": ["logs"] } },
                { "argv": { "prefix": ["stats"] } },
                { "argv": { "prefix": ["builder", "status"] } },
                { "argv": { "prefix": ["image", "list"] } },
                { "argv": { "prefix": ["image", "inspect"] } },
                { "argv": { "prefix": ["registry", "list"] } },
                { "argv": { "prefix": ["network", "list"] } },
                { "argv": { "prefix": ["network", "inspect"] } },
                { "argv": { "prefix": ["volume", "list"] } },
                { "argv": { "prefix": ["volume", "inspect"] } },
                { "argv": { "prefix": ["machine", "list"] } },
                { "argv": { "prefix": ["machine", "inspect"] } },
                { "argv": { "prefix": ["machine", "logs"] } },
                { "argv": { "prefix": ["system", "version"] } },
                { "argv": { "prefix": ["system", "df"] } },
                { "argv": { "prefix": ["system", "property", "list"] } },
                { "argv": { "prefix": ["system", "dns", "list"] } }
              ]
            }
          }
        }
      }
    }
  }
}

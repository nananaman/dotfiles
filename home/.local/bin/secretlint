#!/usr/bin/env bash
set -euo pipefail
runtime="$HOME/.local/share/dotfiles/secretlint"
cli="$runtime/node_modules/secretlint/bin/secretlint.js"
if [[ ! -f "$cli" ]]; then
  echo 'secretlint: run dotfiles setup to install the locked CLI and rules.' >&2
  exit 127
fi
exec "$HOME/.local/bin/dotfiles-exec" node node "$cli" "$@"

#!/usr/bin/env bash
set -euo pipefail
mise_bin=${MISE_BIN:-mise}
installation=$("$mise_bin" --cd / --no-env --no-hooks where npm:@earendil-works/pi-coding-agent)
for modules in "$installation/node_modules" "$installation/lib/node_modules"; do
  cli="$modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js"
  if [[ -f "$cli" ]]; then
    exec "$HOME/.local/bin/dotfiles-exec" node node "$cli" "$@"
  fi
done
echo 'pi: JavaScript entry point was not found in the mise installation.' >&2
exit 127

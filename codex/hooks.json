{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.codex/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "python3 \"$HOME/.codex/hooks/herdr-auto-title.py\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
